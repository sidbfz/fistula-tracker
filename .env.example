# RevenueCat public SDK keys. These are app-specific public identifiers, not secret API keys.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key

# Optional while developing with RevenueCat Test Store. Never set this in a production build.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_your_public_sdk_key
